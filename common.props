<Project>
  <PropertyGroup>
    <Authors>Ray</Authors>
    <!-- Version authority is git tag history (CI-managed). Local builds stay 0.0.0-dev. -->
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <NoWarn>$(NoWarn);CS1591;CS0436</NoWarn>
  </PropertyGroup>
</Project>
